# Copy to .env and adjust. Every value has a working default (see
# app/config.py) — this file only needs to change if you're not using
# docker-compose's default service names/ports.

DATABASE_URL=postgresql+asyncpg://order_user:order_pass@localhost:5432/orders
REDIS_URL=redis://localhost:6379/0

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ORDER_EVENTS_TOPIC=order-events
# Set true to run the API without a real Kafka broker (publishes to an
# in-memory fake instead) — handy for quick local hacking.
KAFKA_FAKE=false

OUTBOX_POLL_INTERVAL_SECONDS=1.0
OUTBOX_BATCH_SIZE=50
# true: relay runs as a background task inside the API process (simplest).
# false: run `python -m app.workers.outbox_relay` as its own process/container
# instead — see docker-compose.yml for both.
OUTBOX_RELAY_IN_PROCESS=true

CACHE_L1_MAX_SIZE=1000
CACHE_L1_TTL_SECONDS=5.0
CACHE_L2_TTL_SECONDS=60.0

RATE_LIMIT_TIMES=20
RATE_LIMIT_SECONDS=60

BREAKER_FAILURE_THRESHOLD=5
BREAKER_RECOVERY_SECONDS=30.0

# Simulated payment gateway — crank these up locally to see the circuit
# breaker and payment_failed path actually trigger.
PAYMENT_GATEWAY_FAILURE_RATE=0.0
PAYMENT_GATEWAY_LATENCY_MS=50
